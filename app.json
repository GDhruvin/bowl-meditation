{
  "expo": {
    "name": "Mind Ripple",
    "slug": "mind-ripple",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/image/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/image/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/image/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.mindripple.app"
    },
    "web": {
      "favicon": "./assets/image/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1eda968f-0be5-49d6-8ffa-812961f485f0"
      }
    },
    "owner": "dhruvin.456"
  }
}
